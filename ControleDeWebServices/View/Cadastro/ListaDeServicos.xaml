<Page x:Class="ControleDeWebServices.View.Cadastro.ListaDeServicos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="650"
      d:DesignWidth="850"
      Title="Servicos">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#2F6F8F"/>
            <Setter Property="BorderBrush" Value="#2F6F8F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
        <Style x:Key="SuccessActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#4E9A57"/>
            <Setter Property="BorderBrush" Value="#4E9A57"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#B94E45"/>
            <Setter Property="BorderBrush" Value="#B94E45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <Style x:Key="GridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#2F6F8F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F7F9FA">
        <Border Margin="18" Padding="18" Background="#FCFDFD" BorderBrush="#D7E0E4" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Servicos" FontSize="22" FontWeight="SemiBold" Foreground="#172126"/>
                        <TextBlock Text="Consulta e manutencao de servicos" Margin="0,3,0,0" Foreground="#5C6B73"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SuccessActionButton}" Command="{Binding IncluirCommand}" Content="Incluir"/>
                </Grid>

                <Border Grid.Row="1" Margin="0,16,0,14" Padding="12" Background="#F7F9FA" BorderBrush="#D7E0E4" BorderThickness="1" CornerRadius="4" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid DataContext="{Binding Editor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Titulo}" FontSize="16" FontWeight="SemiBold" Foreground="#172126"/>
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Nome do servico" Text="{Binding NomeServico, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" materialDesign:HintAssist.Hint="UF" ItemsSource="{Binding Estados}" SelectedItem="{Binding Uf, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding DataContext.SalvarCommand, RelativeSource={RelativeSource AncestorType=Page}}" Content="Salvar"/>
                                <Button Margin="8,0,0,0" Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=Page}}" Content="Cancelar"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Servicos}" SelectedItem="{Binding SelectedServico, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" SelectionMode="Single" Background="#FCFDFD" RowBackground="#FCFDFD" AlternatingRowBackground="#F7F9FA" Foreground="#172126" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#D7E0E4" HeadersVisibility="Column" materialDesign:DataGridAssist.CellPadding="10,7,10,7" materialDesign:DataGridAssist.ColumnHeaderPadding="10,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Servico" Width="*" Binding="{Binding NomeServico}" HeaderStyle="{StaticResource GridHeaderStyle}"/>
                        <DataGridTextColumn Header="UF" Width="70" Binding="{Binding Uf}" HeaderStyle="{StaticResource GridHeaderStyle}"/>
                        <DataGridTemplateColumn Header="Acoes" Width="170" HeaderStyle="{StaticResource GridHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Height="28" Padding="10,0" Style="{StaticResource PrimaryActionButton}" Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Content="Editar"/>
                                        <Button Height="28" Padding="10,0" Margin="8,0,0,0" Style="{StaticResource DangerActionButton}" Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Content="Excluir"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="{Binding TotalRegistros}" Foreground="#5C6B73" VerticalAlignment="Center"/>
                    <TextBlock Text="Nenhum servico cadastrado" HorizontalAlignment="Center" Foreground="#5C6B73" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
