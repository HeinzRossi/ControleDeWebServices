<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ControleDeWebServices.View.Cadastro"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:materialDesignConverters="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
      xmlns:Modelo="clr-namespace:ControleDeWebServices.Modelo" 
      x:Class="ControleDeWebServices.View.Cadastro.CadastroDeInformacoes"
      mc:Ignorable="d" 
      d:DesignHeight="400" 
      Title="CadastroDeInformacoes">

    <Grid Background="WhiteSmoke" Width="850">
        <StackPanel Orientation="Vertical">
            <Grid x:Name="GridBotoes">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Botoes" HorizontalAlignment="Right" Margin="0,5,10,0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,10,0">
                        <Button 
                            x:Name="btnGravar"
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            HorizontalAlignment="Right" 
                            ToolTip="Salvar" 
                            Height="Auto" 
                            Background="#CC5743"
                            BorderBrush="#CC5743"
                            IsEnabled="True" Click="BtnGravar_Click" >
                            <materialDesign:PackIcon Kind="ContentSave" Height="24" Width="24"/>
                        </Button>
                    </StackPanel>
                    <StackPanel >
                        <Button 
                            x:Name="btnCancelar"
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            HorizontalAlignment="Right" 
                            ToolTip="Cancelar" 
                            Height="Auto" 
                            Background="#4383CC"
                            BorderBrush="#4383CC"
                            IsEnabled="True" Click="BtnCancelar_Click" >
                            <materialDesign:PackIcon Kind="ArrowBack" Height="24" Width="24"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel>
                <Grid x:Name="CamposDeServico" VerticalAlignment="Top" Margin="0,15,0,0">
                    <StackPanel Height="26" VerticalAlignment="Top" Margin="10,5,5,0" Grid.Column="0" Orientation="Horizontal">
                        <Label Content="Estado:" HorizontalAlignment="Left"/>
                        <TextBox x:Name="txtNomeUf" materialDesign:HintAssist.Hint="UF" Width="30" HorizontalAlignment="Left" Margin="5,0,0,0" FontWeight="Bold" IsEnabled="False"/>
                        <Label Content="Cliente:" HorizontalAlignment="Left"/>
                        <TextBox x:Name="txtNomeCliente" materialDesign:HintAssist.Hint="Nome do Cliente" Width="320" HorizontalAlignment="Left" Margin="5,0,0,0" FontWeight="Bold" IsEnabled="False"/>
                        <Label Content="Sistema:" HorizontalAlignment="Left"/>
                        <TextBox x:Name="txtSistema" materialDesign:HintAssist.Hint="Nome do Sistema" Width="380" HorizontalAlignment="Left" Margin="5,0,0,0" FontWeight="Bold" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Height="26" VerticalAlignment="Top" Margin="10,30,5,0" Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="245"/>
                                <ColumnDefinition Width="57"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtNomeDoArquivo" materialDesign:HintAssist.Hint="Arquivo Executável" HorizontalAlignment="Left" Width="245" Grid.Column="0" Focusable="True" Grid.ColumnSpan="2" CharacterCasing="Upper"/>
                            <Button 
                            x:Name="btnNomearquivo" 
                            Foreground="White" 
                            Height="26" 
                            Margin="13,0,3,0" 
                            Grid.Column="1" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="BtnNomearquivo_Click"
                            Background="#4383CC">
                                <materialDesign:PackIcon Kind="EllipsisHorizontal" Height="15" Width="15"/>
                            </Button>
                            <TextBox x:Name="txtNomeDoCaminho" materialDesign:HintAssist.Hint="Arquivo de Configuracao" Width="245" Margin="12,0,0,0" HorizontalAlignment="Left" Grid.Column="2" CharacterCasing="Upper"/>
                            <Button 
                            x:Name="btnNomeCaminho" 
                            Foreground="White" 
                            Height="26" 
                            Width="45" 
                            HorizontalAlignment="Left" 
                            Margin="12,0,0,0" 
                            Grid.Column="3" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="BtnNomeCaminho_Click"
                            Background="#4383CC">
                                <materialDesign:PackIcon Kind="EllipsisHorizontal" Height="15" Width="15"/>
                            </Button>
                            <ComboBox
                                x:Name="cbbSecao"
                                materialDesign:ComboBoxAssist.ShowSelectedItem="{Binding ElementName=DisplaySelectedItemCheckBox, Path=IsChecked}"
                                DisplayMemberPath="NomeSecao"
                                SelectedValuePath="IdSecao"
                                materialDesign:HintAssist.Hint="Seção para Conexão"
                                Grid.Column="4"
                                Height="26"
                                HorizontalAlignment="Left"
                                Width="auto"
                                Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Height="26" VerticalAlignment="Top" Margin="5,60,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtServidor" materialDesign:HintAssist.Hint="Servidor" HorizontalAlignment="Left" Margin="5,0,0,0" Width="150" Grid.Column="0" CharacterCasing="Upper"/>
                            <TextBox x:Name="txtPorta" materialDesign:HintAssist.Hint="Porta" HorizontalAlignment="Left" Margin="10,0,0,0" Width="50" Grid.Column="1" PreviewTextInput="TxtPorta_PreviewTextInput"/>
                            <TextBox x:Name="txtDataBase" materialDesign:HintAssist.Hint="Banco de Dados" HorizontalAlignment="Left" Margin="10,0,0,0" Width="157" Grid.Column="3" CharacterCasing="Upper"/>
                            <ComboBox
                                x:Name="cbbTipoConexao"
                                materialDesign:ComboBoxAssist.ShowSelectedItem="{Binding ElementName=DisplaySelectedItemCheckBox, Path=IsChecked}"
                                materialDesign:HintAssist.Hint="Tipo de Conexão"
                                Grid.Column="4"
                                Height="26"
                                HorizontalAlignment="Left"
                                Width="115"
                                Margin="10,0,0,0"/>
                            <TextBox x:Name="txtUsuario" materialDesign:HintAssist.Hint="Usuário" HorizontalAlignment="Left" Margin="10,0,0,0" Width="150" Grid.Column="5"/>
                            <PasswordBox x:Name="txtSenha" materialDesign:HintAssist.Hint="Senha" Width="230" HorizontalAlignment="Left" Margin="5,0,0,0" Grid.Column="6" PasswordChar="*" Height="26" VerticalAlignment="Top"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Height="26" VerticalAlignment="Top" Margin="5,90,0,0">
                        <CheckBox x:Name ="chkCriptografia" 
                                      Content="Não utiliza Criptografia"
                                      HorizontalAlignment ="Right"
                                      Margin="0,0,30,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <materialDesign:Card Margin="10,20,9.6,50" Height="452" Background="WhiteSmoke">
                <StackPanel>
                    <StackPanel Margin="5" Height="30" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtSecao" 
                                 materialDesign:HintAssist.Hint="Nome da Seção" 
                                 Width="380" 
                                 Margin="12,0,0,0" 
                                 HorizontalAlignment="Left" 
                                 Grid.Column="0" 
                                 CharacterCasing="Upper"/>
                            <TextBox x:Name="txtParametro" 
                                 materialDesign:HintAssist.Hint="Nome do Parametro" 
                                 Width="380" 
                                 Margin="12,0,0,0" 
                                 HorizontalAlignment="Left" 
                                 Grid.Column="1" 
                                 CharacterCasing="Upper"/>
                            <TextBox x:Name="txtValor" 
                                 materialDesign:HintAssist.Hint="Valor Padrão do Parâmetro" 
                                 Width="380" 
                                 Margin="12,0,0,0" 
                                 HorizontalAlignment="Left" 
                                 Grid.Column="2" 
                                 CharacterCasing="Upper"/>
                            <Button x:Name="btnInserirParametro" 
                                    Foreground="White"
                                    Height="26" 
                                    Width="150" 
                                    HorizontalAlignment="Left" 
                                    Margin="12,0,0,0" 
                                    Grid.Column="3" 
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Click="btnInserirParametro_Click"
                                    Background="#4383CC">
                                <TextBlock Text="Inserir Parametro"/>
                            </Button>
                            <Button x:Name="btnImportarParametro" 
                                    Foreground="White"
                                    Height="26" 
                                    Width="100" 
                                    HorizontalAlignment="Left" 
                                    Margin="0,0,0,0" 
                                    Grid.Column="4" 
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Click="btnImportarParametro_Click"
                                    Background="#4383CC">
                                <TextBlock Text="Importar"/>
                            </Button>                            
                        </Grid>
                    </StackPanel>
                    <DataGrid x:Name="GridParametros" 
                              Margin="5,5,10,10"
                              CanUserSortColumns="True"
                              CanUserAddRows="False"
                              AutoGenerateColumns="False"
                              materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="5" 
                              Foreground="Black"
                              HorizontalGridLinesBrush="WhiteSmoke" 
                              RowBackground="WhiteSmoke"
                              Background="WhiteSmoke"
                              SelectionMode="Extended" 
                              Height="450">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                x:Name="Secao"
                                Binding="{Binding Secao, Mode=OneWay}"
                                Width="*"
                                Header="Seção"
                                EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                                Foreground="Black">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style
                                        TargetType="{x:Type DataGridColumnHeader}"
                                        BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter
                                        Property="Background"
                                        Value="#4383CC"/>
                                        <Setter
                                        Property="Foreground"
                                        Value="White"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                x:Name="Parametro"
                                Binding="{Binding Parametro, Mode=OneWay}"
                                Width="*"
                                Header="Parametro"
                                EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                                Foreground="Black">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style
                                        TargetType="{x:Type DataGridColumnHeader}"
                                        BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter
                                        Property="Background"
                                        Value="#4383CC"/>
                                        <Setter
                                        Property="Foreground"
                                        Value="White"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                x:Name="Valor"
                                Binding="{Binding Valor, Mode=OneWay}"
                                Width="*"
                                Header="Valor"
                                EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                                Foreground="Black">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style
                                        TargetType="{x:Type DataGridColumnHeader}"
                                        BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter
                                        Property="Background"
                                        Value="#4383CC"/>
                                        <Setter
                                        Property="Foreground"
                                        Value="White"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style
                                    x:Name="Excluir"
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter Property="Background" Value="#4383CC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Content" Value="Excluir"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button 
                                        x:Name="btnExcluir"
                                        Content="Excluir"
                                        Height="25"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#CC5743"
                                        BorderBrush="#CC5743"
                                        Click="btnExcluir_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </Grid>
</Page>
