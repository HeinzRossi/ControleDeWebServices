<Window x:Class="ControleDeWebServices.View.Cadastro.ImportarParametrosDe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        mc:Ignorable="d"
        Title="Importar parâmetros" Height="220" Width="420">
    <Border Background="#FCFDFD" BorderBrush="#D7E0E4" BorderThickness="1" CornerRadius="6" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Importar parâmetros" FontSize="18" FontWeight="SemiBold" Foreground="#172126"/>
                <TextBlock Text="Escolha a origem para copiar parâmetros" Margin="0,3,0,0" Foreground="#5C6B73"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox materialDesign:HintAssist.Hint="UF" ItemsSource="{Binding Ufs}" SelectedItem="{Binding SelectedUf, Mode=TwoWay}" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" materialDesign:HintAssist.Hint="Cliente" ItemsSource="{Binding Clientes}" SelectedItem="{Binding SelectedCliente, Mode=TwoWay}" DisplayMemberPath="Nome"/>
            </Grid>

            <ComboBox Grid.Row="2" Margin="0,12,0,0" materialDesign:HintAssist.Hint="Sistema" ItemsSource="{Binding Sistemas}" SelectedItem="{Binding SelectedSistema, Mode=TwoWay}" DisplayMemberPath="NomeSistema"/>

            <StackPanel Grid.Row="3" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="#4E9A57" BorderBrush="#4E9A57" Foreground="White" Command="{Binding ImportarCommand}" Content="Importar"/>
                <Button Margin="8,0,0,0" Command="{Binding CancelarCommand}" Content="Fechar"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
