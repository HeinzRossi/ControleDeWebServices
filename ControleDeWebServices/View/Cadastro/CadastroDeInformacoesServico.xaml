<Page x:Class="ControleDeWebServices.View.Cadastro.CadastroDeInformacoesServico"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ControleDeWebServices.View.Cadastro"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      Title="CadastroDeInformacoesServico">

    <Grid Background="WhiteSmoke" Width="850">
        <StackPanel Orientation="Vertical">
            <Grid x:Name="GridBotoes">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Botoes" HorizontalAlignment="Right" Margin="0,5,10,0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,10,0">
                        <Button 
                            x:Name="btnGravar"
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            HorizontalAlignment="Right" 
                            ToolTip="Salvar" 
                            Height="Auto" 
                            Background="#CC5743"
                            BorderBrush="#CC5743"
                            IsEnabled="True" Click="BtnGravar_Click">
                            <materialDesign:PackIcon Kind="ContentSave" Height="24" Width="24"/>
                        </Button>
                    </StackPanel>
                    <StackPanel >
                        <Button 
                            x:Name="btnCancelar"
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            HorizontalAlignment="Right" 
                            ToolTip="Cancelar" 
                            Height="Auto" 
                            Background="#4383CC"
                            BorderBrush="#4383CC"
                            IsEnabled="True" Click="BtnCancelar_Click">
                            <materialDesign:PackIcon Kind="ArrowBack" Height="24" Width="24"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel>
                <Grid x:Name="CamposDeServico" VerticalAlignment="Top" Margin="0,15,0,0">
                    <StackPanel Height="26" VerticalAlignment="Top" Margin="10,5,5,0" Grid.Column="0" Orientation="Horizontal">
                        <Label Content="Estado:" HorizontalAlignment="Left"/>
                        <TextBox x:Name="txtNomeUf" materialDesign:HintAssist.Hint="UF" Width="30" HorizontalAlignment="Left" Margin="5,0,0,0" FontWeight="Bold" IsEnabled="False"/>
                        <Label Content="Cliente:" HorizontalAlignment="Left"/>
                        <TextBox x:Name="txtNomeCliente" materialDesign:HintAssist.Hint="Nome do Cliente" Width="310" HorizontalAlignment="Left" Margin="5,0,0,0" FontWeight="Bold" IsEnabled="False"/>
                        <Label Content="Sistema:" HorizontalAlignment="Left"/>
                        <TextBox x:Name="txtNomeSistema" materialDesign:HintAssist.Hint="Nome do Sistema" Width="130" HorizontalAlignment="Left" Margin="5,0,0,0" FontWeight="Bold" IsEnabled="False"/>
                        <Label Content="Servico:" HorizontalAlignment="Left"/>
                        <TextBox x:Name="txtNomeServico" materialDesign:HintAssist.Hint="Nome do Sistema" Width="130" HorizontalAlignment="Left" Margin="5,0,0,0" FontWeight="Bold" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Height="26" VerticalAlignment="Top" Margin="10,30,5,0" Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="298"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtNomeDoArquivo" materialDesign:HintAssist.Hint="Arquivo Executavel" HorizontalAlignment="Left" Width="325" Grid.Column="0" Focusable="True" Grid.ColumnSpan="2" CharacterCasing="Upper"/>
                            <Button 
                            x:Name="btnCaminhoSistema" 
                            Foreground="White" 
                            Height="26" 
                            Margin="251,0,0,0" 
                            Grid.Column="1" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="BtnCaminhoSistema_Click"
                            Background="#4383CC">
                                <materialDesign:PackIcon Kind="EllipsisHorizontal" Height="15" Width="15"/>
                            </Button>
                            <TextBox x:Name="txtNomeDoCaminho" materialDesign:HintAssist.Hint="Arquivo de Configuracao" Width="380" Margin="12,0,0,0" HorizontalAlignment="Left" Grid.Column="2" CharacterCasing="Upper"/>
                            <Button 
                            x:Name="btnNomeCaminho" 
                            Foreground="White" 
                            Height="26" 
                            Margin="8,0,-48,0" 
                            Grid.Column="3" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="BtnNomeCaminho_Click"
                            Background="#4383CC" HorizontalAlignment="Left" Width="48" VerticalAlignment="Bottom">
                                <materialDesign:PackIcon Kind="EllipsisHorizontal" Height="15" Width="15"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Height="26" VerticalAlignment="Top" Margin="5,60,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtServidor" materialDesign:HintAssist.Hint="Servidor" HorizontalAlignment="Left" Margin="5,0,0,0" Width="150" Grid.Column="0" CharacterCasing="Upper"/>
                            <TextBox x:Name="txtPorta" materialDesign:HintAssist.Hint="Porta" HorizontalAlignment="Left" Margin="10,0,0,0" Width="50" Grid.Column="1" PreviewTextInput="TxtPorta_PreviewTextInput"/>
                            <TextBox x:Name="txtDataBase" materialDesign:HintAssist.Hint="Banco de Dados" HorizontalAlignment="Left" Margin="10,0,0,0" Width="157" Grid.Column="3"/>
                            <ComboBox
                                x:Name="cbbTipoConexao"
                                materialDesign:ComboBoxAssist.ShowSelectedItem="{Binding ElementName=DisplaySelectedItemCheckBox, Path=IsChecked}"
                                materialDesign:HintAssist.Hint="Tipo de Conexão"
                                Grid.Column="4"
                                Height="26"
                                HorizontalAlignment="Left"
                                Width="115"
                                Margin="10,0,0,0"/>
                            <TextBox x:Name="txtUsuario" materialDesign:HintAssist.Hint="Usuário" HorizontalAlignment="Left" Margin="10,0,0,0" Width="150" Grid.Column="5"/>
                            <PasswordBox x:Name="txtSenha" materialDesign:HintAssist.Hint="Senha" Width="155" HorizontalAlignment="Left" Margin="5,0,0,0" Grid.Column="6" PasswordChar="*"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
