<Page x:Class="ControleDeWebServices.View.Cadastro.ListaDeSistemas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ControleDeWebServices.View"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      Title="ListaDeSistemas">

    <Grid Background="WhiteSmoke" Width="850">
        <StackPanel Orientation="Vertical">
            <Frame x:Name="FrameInserirtEditar" NavigationUIVisibility="Hidden"/>
        </StackPanel>
        <StackPanel x:Name="TelaConsultaSistema" Orientation="Vertical" Visibility="Visible">
            <StackPanel>
                <Button 
                    x:Name="btnIncluir"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Left" 
                    ToolTip="Incluir" 
                    Height="auto"
                    IsEnabled="True"
                    Background="#85CC89"    
                    BorderBrush="#85CC89"
                    Margin="5,5,0,5" Click="BtnIncluir_Click" Content="Incluir"/>
            </StackPanel>
            <Grid x:Name="CamposDeServico" VerticalAlignment="Top" Margin="0,15,0,0">
                <DataGrid  
                    x:Name="GridSistemas"
                    Margin="5,5,10,10"
                    CanUserSortColumns="True"
                    CanUserAddRows="False"
                    AutoGenerateColumns="False"
                    materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                    materialDesign:DataGridAssist.ColumnHeaderPadding="5" 
                    Foreground="Black"
                    HorizontalGridLinesBrush="WhiteSmoke" 
                    RowBackground="WhiteSmoke"
                    Background="WhiteSmoke"
                    SelectionMode="Extended" 
                    SelectionChanged="GridSistemas_SelectionChanged"
                    Height="600">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            x:Name="Nome"
                            Binding="{Binding NomeSistema, Mode=OneWay}"
                            Width="*"
                            Header="Sistema"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                            <DataGridTextColumn.HeaderStyle>
                                <Style
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                    <Setter
                                    Property="Foreground"
                                    Value="White"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            x:Name="Caminho"
                            Binding="{Binding Uf, Mode=OneWay}"
                            Width="80"
                            Header="Estado"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}" 
                            Foreground="Black">
                            <DataGridTextColumn.HeaderStyle>
                                <Style
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                    <Setter
                                    Property="Foreground"
                                    Value="White"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style
                                    x:Name="Editar"
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="Background" Value="#4383CC"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Content" Value="Editar"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button 
                                        x:Name="btnEditar"
                                        Content="Editar"
                                        Height="25"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#4383CC"
                                        BorderBrush="#4383CC"
                                        Click="BtnEditar_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style
                                    x:Name="Excluir"
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="Background" Value="#4383CC"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Content" Value="Excluir"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button 
                                        x:Name="btnExcluir"
                                        Content="Excluir"
                                        Height="25"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#CC5743"
                                        BorderBrush="#CC5743"
                                        Click="BtnExcluir_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>                        
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
