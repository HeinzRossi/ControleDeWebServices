<Page x:Class="ControleDeWebServices.View.Cadastro.ListaDeClientes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="650"
      d:DesignWidth="850"
      Title="Clientes">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Background="{StaticResource App.Brush.Background}">
        <Border Margin="18"
                Padding="18"
                Background="{StaticResource App.Brush.Surface}"
                BorderBrush="{StaticResource App.Brush.Border}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Clientes"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource App.Brush.TextPrimary}"/>
                        <TextBlock Text="Consulta e manutenção de clientes"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource App.Brush.TextSecondary}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource App.SuccessButton}"
                            Command="{Binding IncluirCommand}"
                            IsEnabled="{Binding CanUseListActions}"
                            Content="Incluir"/>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,16,0,14"
                        Padding="12"
                        Background="{StaticResource App.Brush.Background}"
                        BorderBrush="{StaticResource App.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid DataContext="{Binding Editor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Titulo}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource App.Brush.TextPrimary}"/>
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Código"
                                     Text="{Binding CodigoControle, UpdateSourceTrigger=PropertyChanged}"
                                     CharacterCasing="Upper"
                                     Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     materialDesign:HintAssist.Hint="Nome do cliente"
                                     Text="{Binding NomeCliente, UpdateSourceTrigger=PropertyChanged}"
                                     CharacterCasing="Upper"
                                     Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="2"
                                      materialDesign:HintAssist.Hint="UF"
                                      ItemsSource="{Binding Estados}"
                                      SelectedItem="{Binding Uf, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Style="{StaticResource App.PrimaryButton}"
                                        Command="{Binding DataContext.SalvarCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        Content="Salvar"/>
                                <Button Margin="8,0,0,0"
                                        Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        Content="Cancelar"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <DataGrid Style="{StaticResource App.DataGrid}" Grid.Row="2" IsReadOnly="True"
                          ItemsSource="{Binding Clientes}"
                          SelectedItem="{Binding SelectedCliente, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsEnabled="{Binding IsListEnabled}"
                          CanUserAddRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          Background="{StaticResource App.Brush.Surface}"
                          RowBackground="{StaticResource App.Brush.Surface}"
                          AlternatingRowBackground="{StaticResource App.Brush.Background}"
                          Foreground="{StaticResource App.Brush.TextPrimary}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource App.Brush.Border}"
                          HeadersVisibility="Column"
                          materialDesign:DataGridAssist.CellPadding="10,7,10,7"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="10,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código"
                                            Width="90"
                                            Binding="{Binding CodigoControle}"
                                            HeaderStyle="{StaticResource App.GridHeader}"/>
                        <DataGridTextColumn Header="Cliente"
                                            Width="*"
                                            Binding="{Binding NomeCliente}"
                                            HeaderStyle="{StaticResource App.GridHeader}"/>
                        <DataGridTextColumn Header="UF"
                                            Width="70"
                                            Binding="{Binding Uf}"
                                            HeaderStyle="{StaticResource App.GridHeader}"/>
                        <DataGridTemplateColumn Header="Ações"
                                                Width="170"
                                                HeaderStyle="{StaticResource App.GridHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Height="28"
                                                Padding="10,0"
                                                Style="{StaticResource App.PrimaryButton}"
                                                Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.CanUseListActions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Content="Editar"/>
                                        <Button Height="28"
                                                Padding="10,0"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource App.DangerButton}"
                                                Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.CanUseListActions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Content="Excluir"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="{Binding TotalRegistros}"
                               Foreground="{StaticResource App.Brush.TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Nenhum cliente cadastrado"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource App.Brush.TextSecondary}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
