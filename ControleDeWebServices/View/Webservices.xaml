<Page x:Class="ControleDeWebServices.View.WebServices"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ControleDeWebServices.View"
      xmlns:diversos="clr-namespace:ControleDeWebServices.Diversos"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      Title="WebServices">
    <Page.Resources>
        <diversos:EnumConverter x:Key="GeneralEnumConverter"/>
    </Page.Resources>
    
    <Grid Background="WhiteSmoke" Width="850">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid VerticalAlignment="Top" Margin="0,10,0,0" Height="350" Grid.Row="0">
            <Label Content="Sistemas mais acessados" FontWeight="Bold" FontSize="18" Foreground="#DD057C2B" />
            <DataGrid  
                    x:Name="Grid10Mais"
                    Margin="5,5,10,10"
                    CanUserSortColumns="True"
                    CanUserAddRows="False"
                    AutoGenerateColumns="False"
                    materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                    materialDesign:DataGridAssist.ColumnHeaderPadding="5" 
                    Foreground="Black"
                    HorizontalGridLinesBrush="WhiteSmoke" 
                    RowBackground="WhiteSmoke"
                    SelectionMode="Extended" 
                    Background="WhiteSmoke" MouseDoubleClick="Grid10Mais_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn
                            x:Name="IdCliente10Mais"
                            Binding="{Binding CodigoControle, Mode=OneWay}"
                            Width="80"
                            Header="Código"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                        <DataGridTextColumn.HeaderStyle>
                            <Style
                                TargetType="{x:Type DataGridColumnHeader}"
                                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                            x:Name="NomeCliente10Mais"
                            Binding="{Binding NomeCliente, Mode=OneWay}"
                            Width="*"
                            Header="Cliente"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                        <DataGridTextColumn.HeaderStyle>
                            <Style
                                TargetType="{x:Type DataGridColumnHeader}"
                                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                            x:Name="NomeSistema10Mais"
                            Binding="{Binding NomeSistema, Mode=OneWay}"
                            Width="*"
                            Header="Sistema"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                        <DataGridTextColumn.HeaderStyle>
                            <Style
                                TargetType="{x:Type DataGridColumnHeader}"
                                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                            x:Name="Uf10Mais"
                            Binding="{Binding Uf, Mode=OneWay}"
                            Width="*"
                            Header="UF"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                        <DataGridTextColumn.HeaderStyle>
                            <Style
                                TargetType="{x:Type DataGridColumnHeader}"
                                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                            x:Name="TipoConexao10Mais"
                            Binding="{Binding TipoConexao,Converter={StaticResource GeneralEnumConverter}, Mode=OneWay}"
                            Width="*"
                            Header="Tipo Conexao"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                        <DataGridTextColumn.HeaderStyle>
                            <Style
                                TargetType="{x:Type DataGridColumnHeader}"
                                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn 
                        Header="URL">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style
                                TargetType="{x:Type DataGridColumnHeader}"
                                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Style>                        
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="btnAtualizarUrlMais10" 
                                        Content="Atualizar" 
                                        Height="25"
                                        Background="#4383CC"
                                        BorderBrush="#4383CC"                                        
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="btnAtualizarUrlMais10_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Grid.Row="1">
            <TextBlock Text="Buscar por: " Margin="10,5,0,0" Width="65" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignBody1TextBlock}" VerticalAlignment="Center"/>
            <TextBox x:Name="txtIdCliente" materialDesign:HintAssist.Hint="Cód. Cliente" Width="80" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center" TextChanged="TxtIdCliente_TextChanged"/>
            <TextBlock Text="Selecionar:" Margin="10,5,0,0" Width="60" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignBody1TextBlock}" VerticalAlignment="Center"/>
            <ComboBox
                    x:Name="cbbUF"
                    Margin="10,0,0,0"
                    materialDesign:ComboBoxAssist.ShowSelectedItem="{Binding IsChecked, ElementName=DisplaySelectedItemCheckBox}"
                    materialDesign:HintAssist.Hint="UF"
                    Height="26"
                    HorizontalAlignment="Left"
                    Width="60"
                    VerticalAlignment="Center"
                    SelectionChanged="CbbUF_SelectionChanged"/>
            <TextBlock x:Name="txtSelecionarCliente" Text="Selecionar:" Margin="10,5,0,0" Width="60" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignBody1TextBlock}" VerticalAlignment="Center"/>
            <ComboBox
                    x:Name="cbbClientes"
                    Margin="10,0,0,0"
                    materialDesign:ComboBoxAssist.ShowSelectedItem="{Binding IsChecked, ElementName=DisplaySelectedItemCheckBox}"
                    materialDesign:HintAssist.Hint="Cliente"
                    Height="26"
                    HorizontalAlignment="Left"
                    Width="300"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding Path=NomeCliente}"
                    SelectedValue="{Binding Path=IdCliente}"
                    SelectedIndex="{Binding Path=IdCliente}"
                    DisplayMemberPath="NomeCliente"
                    SelectedValuePath="NomeCliente"
                    SelectionChanged="CbbClientes_SelectionChanged"/>
        </StackPanel>
        <Grid VerticalAlignment="Top" Margin="0,10,0,0" Height="200" Grid.Row="2">
            <DataGrid  
                    x:Name="GridSistemas"
                    Margin="5,5,10,10"
                    CanUserSortColumns="True"
                    CanUserAddRows="False"
                    AutoGenerateColumns="False"
                    materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                    materialDesign:DataGridAssist.ColumnHeaderPadding="5" 
                    Foreground="Black"
                    HorizontalGridLinesBrush="WhiteSmoke" 
                    RowBackground="WhiteSmoke"
                    SelectionMode="Extended" 
                    Background="WhiteSmoke" MouseDoubleClick="GridSistemas_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn
                            x:Name="IdCliente"
                            Binding="{Binding CodigoControle, Mode=OneWay}"
                            Width="80"
                            Header="Código"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                        <DataGridTextColumn.HeaderStyle>
                            <Style
                                TargetType="{x:Type DataGridColumnHeader}"
                                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>                    
                    <DataGridTextColumn
                            x:Name="NomeCliente"
                            Binding="{Binding NomeCliente, Mode=OneWay}"
                            Width="*"
                            Header="Cliente"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                        <DataGridTextColumn.HeaderStyle>
                            <Style
                                TargetType="{x:Type DataGridColumnHeader}"
                                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                            x:Name="NomeSistema"
                            Binding="{Binding NomeSistema, Mode=OneWay}"
                            Width="*"
                            Header="Sistema"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                        <DataGridTextColumn.HeaderStyle>
                            <Style
                                TargetType="{x:Type DataGridColumnHeader}"
                                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                            x:Name="Uf"
                            Binding="{Binding Uf, Mode=OneWay}"
                            Width="*"
                            Header="UF"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                        <DataGridTextColumn.HeaderStyle>
                            <Style
                                TargetType="{x:Type DataGridColumnHeader}"
                                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                            x:Name="TipoConexao"
                            Binding="{Binding TipoConexao,Converter={StaticResource GeneralEnumConverter}, Mode=OneWay}"
                            Width="*"
                            Header="Tipo Conexao"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                        <DataGridTextColumn.HeaderStyle>
                            <Style
                                TargetType="{x:Type DataGridColumnHeader}"
                                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn 
                        Header="URL">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style
                                TargetType="{x:Type DataGridColumnHeader}"
                                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="btnAtualizarUrlSistemas" 
                                        Content="Atualizar" 
                                        Height="25"
                                        Background="#4383CC"
                                        BorderBrush="#4383CC"                                        
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="btnAtualizarUrlSistemas_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
