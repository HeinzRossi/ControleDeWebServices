<Page x:Class="ControleDeWebServices.View.Vinculos.ListaVinculosServico"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ControleDeWebServices.View.Vinculos"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="650" 
      Title="ListaVinculoServico">

   
    <Grid Background="WhiteSmoke" Width="850">
        <StackPanel Orientation="Vertical">
            <Frame x:Name="FrameInserirtEditar" NavigationUIVisibility="Hidden"/>
        </StackPanel>
        <StackPanel x:Name="TelaConsultaServico" Orientation="Vertical" Visibility="Visible">
            <StackPanel>
                <Button 
                    x:Name="btnIncluir"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Left" 
                    ToolTip="Incluir" 
                    Height="auto"
                    IsEnabled="True"
                    Background="#85CC89"    
                    BorderBrush="#85CC89"
                    Margin="5,5,0,5" Content="Incluir" 
                    Click="BtnIncluir_Click"/>
            </StackPanel>
            <Grid VerticalAlignment="Top" Margin="0,15,0,0" Height="200">
                <DataGrid  
                    x:Name="GridClientes"
                    Margin="5,5,10,10"
                    CanUserSortColumns="True"
                    CanUserAddRows="False"
                    AutoGenerateColumns="False"
                    materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                    materialDesign:DataGridAssist.ColumnHeaderPadding="5" 
                    Foreground="Black"
                    HorizontalGridLinesBrush="WhiteSmoke" 
                    RowBackground="WhiteSmoke"
                    SelectionMode="Extended" 
                    Background="WhiteSmoke"
                    SelectionChanged="GridClientes_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            x:Name="IdCliente"
                            Binding="{Binding CodigoControle, Mode=OneWay}"
                            Width="80"
                            Header="Código"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                            <DataGridTextColumn.HeaderStyle>
                                <Style
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                    <Setter
                                    Property="Foreground"
                                    Value="White"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            x:Name="NomeCliente"
                            Binding="{Binding NomeCliente, Mode=OneWay}"
                            Width="*"
                            Header="Cliente"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                            <DataGridTextColumn.HeaderStyle>
                                <Style
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                    <Setter
                                    Property="Foreground"
                                    Value="White"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            x:Name="Estado"
                            Binding="{Binding Uf, Mode=OneWay}"
                            Width="80"
                            Header="Estado"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}" 
                            Foreground="Black">
                            <DataGridTextColumn.HeaderStyle>
                                <Style
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                    <Setter
                                    Property="Foreground"
                                    Value="White"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid VerticalAlignment="Top" Margin="0,15,0,0" Height="200">
                <DataGrid  
                    x:Name="GridSistemas"
                    Margin="5,5,10,10"
                    CanUserSortColumns="True"
                    CanUserAddRows="False"
                    AutoGenerateColumns="False"
                    materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                    materialDesign:DataGridAssist.ColumnHeaderPadding="5" 
                    Foreground="Black"
                    HorizontalGridLinesBrush="WhiteSmoke" 
                    RowBackground="WhiteSmoke"
                    Background="WhiteSmoke"
                    SelectionMode="Extended"
                    SelectionChanged="GridSistemas_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            x:Name="NomeSistema"
                            Binding="{Binding NomeSistema, Mode=OneWay}"
                            Width="*"
                            Header="Sistema"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                            <DataGridTextColumn.HeaderStyle>
                                <Style
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                    <Setter
                                    Property="Foreground"
                                    Value="White"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style
                                    x:Name="Editar"
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="Background" Value="#4383CC"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Content" Value="Editar"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button 
                                        x:Name="btnEditar"
                                        Content="Editar"
                                        Height="25"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#4383CC"
                                        BorderBrush="#4383CC"
                                        Click="BtnEditar_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style
                                    x:Name="Excluir"
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="Background" Value="#4383CC"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Content" Value="Excluir"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button 
                                        x:Name="btnExcluir"
                                        Content="Excluir"
                                        Height="25"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#CC5743"
                                        BorderBrush="#CC5743"
                                        Click="BtnExcluir_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid VerticalAlignment="Top" Margin="0,15,0,0" Height="165">
                <DataGrid  
                    x:Name="GridServicos"
                    Margin="5,5,10,10"
                    CanUserSortColumns="True"
                    CanUserAddRows="False"
                    AutoGenerateColumns="False"
                    materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                    materialDesign:DataGridAssist.ColumnHeaderPadding="5" 
                    Foreground="Black"
                    HorizontalGridLinesBrush="WhiteSmoke" 
                    RowBackground="WhiteSmoke"
                    Background="WhiteSmoke"
                    SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            x:Name="NomeServico"
                            Binding="{Binding NomeServico, Mode=OneWay}"
                            Width="*"
                            Header="Serviço"
                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" 
                            Foreground="Black">
                            <DataGridTextColumn.HeaderStyle>
                                <Style
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter
                                    Property="Background"
                                    Value="#4383CC"/>
                                    <Setter
                                    Property="Foreground"
                                    Value="White"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style
                                    x:Name="Configurar"
                                    TargetType="{x:Type DataGridColumnHeader}"
                                    BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="Background" Value="#4383CC"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Content" Value="Configurar"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button 
                                        x:Name="btnConfigurar"
                                        Height="30"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#4383CC"
                                        BorderBrush="#4383CC"
                                        materialDesign:HintAssist.Hint="Configurar"
                                        Click="BtnConfigurar_Click">
                                        <materialDesign:PackIcon Kind="Settings" Height="24" Width="24"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
