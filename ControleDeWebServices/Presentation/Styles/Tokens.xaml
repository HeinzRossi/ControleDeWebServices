<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Color x:Key="App.Color.Primary">#2F6F8F</Color>
    <Color x:Key="App.Color.PrimaryStrong">#245875</Color>
    <Color x:Key="App.Color.Success">#4E9A57</Color>
    <Color x:Key="App.Color.Danger">#B94E45</Color>
    <Color x:Key="App.Color.Warning">#B9822B</Color>
    <Color x:Key="App.Color.Background">#F7F9FA</Color>
    <Color x:Key="App.Color.Surface">#FCFDFD</Color>
    <Color x:Key="App.Color.SurfaceMuted">#EEF3F5</Color>
    <Color x:Key="App.Color.Border">#D7E0E4</Color>
    <Color x:Key="App.Color.TextPrimary">#172126</Color>
    <Color x:Key="App.Color.TextSecondary">#516168</Color>
    <Color x:Key="App.Color.Overlay">#66172126</Color>

    <SolidColorBrush x:Key="App.Brush.Primary" Color="{StaticResource App.Color.Primary}"/>
    <SolidColorBrush x:Key="App.Brush.PrimaryStrong" Color="{StaticResource App.Color.PrimaryStrong}"/>
    <SolidColorBrush x:Key="App.Brush.Success" Color="{StaticResource App.Color.Success}"/>
    <SolidColorBrush x:Key="App.Brush.Danger" Color="{StaticResource App.Color.Danger}"/>
    <SolidColorBrush x:Key="App.Brush.Warning" Color="{StaticResource App.Color.Warning}"/>
    <SolidColorBrush x:Key="App.Brush.Background" Color="{StaticResource App.Color.Background}"/>
    <SolidColorBrush x:Key="App.Brush.Surface" Color="{StaticResource App.Color.Surface}"/>
    <SolidColorBrush x:Key="App.Brush.SurfaceMuted" Color="{StaticResource App.Color.SurfaceMuted}"/>
    <SolidColorBrush x:Key="App.Brush.Border" Color="{StaticResource App.Color.Border}"/>
    <SolidColorBrush x:Key="App.Brush.TextPrimary" Color="{StaticResource App.Color.TextPrimary}"/>
    <SolidColorBrush x:Key="App.Brush.TextSecondary" Color="{StaticResource App.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="App.Brush.Overlay" Color="{StaticResource App.Color.Overlay}"/>

    <sys:Double x:Key="App.FontSize.Body">13</sys:Double>
    <sys:Double x:Key="App.FontSize.Label">12</sys:Double>
    <sys:Double x:Key="App.FontSize.Section">16</sys:Double>
    <sys:Double x:Key="App.FontSize.Title">22</sys:Double>

    <Thickness x:Key="App.Space.Page">18</Thickness>
    <Thickness x:Key="App.Space.Surface">18</Thickness>
    <Thickness x:Key="App.Space.Panel">12</Thickness>
    <Thickness x:Key="App.Space.Button">14,0</Thickness>
    <Thickness x:Key="App.Space.TableButton">10,0</Thickness>
</ResourceDictionary>
