<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Style x:Key="App.PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{StaticResource App.Brush.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource App.Brush.Primary}"/>
        <Setter Property="Foreground" Value="{StaticResource App.Brush.Surface}"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="{StaticResource App.Space.Button}"/>
    </Style>

    <Style x:Key="App.SuccessButton" TargetType="Button" BasedOn="{StaticResource App.PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource App.Brush.Success}"/>
        <Setter Property="BorderBrush" Value="{StaticResource App.Brush.Success}"/>
    </Style>

    <Style x:Key="App.DangerButton" TargetType="Button" BasedOn="{StaticResource App.PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource App.Brush.Danger}"/>
        <Setter Property="BorderBrush" Value="{StaticResource App.Brush.Danger}"/>
    </Style>

    <Style x:Key="App.SecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Foreground" Value="{StaticResource App.Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource App.Brush.Border}"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="{StaticResource App.Space.Button}"/>
    </Style>

    <Style x:Key="App.IconButton" TargetType="Button" BasedOn="{StaticResource App.PrimaryButton}">
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="App.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource App.Brush.Surface}"/>
        <Setter Property="RowBackground" Value="{StaticResource App.Brush.Surface}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource App.Brush.Background}"/>
        <Setter Property="Foreground" Value="{StaticResource App.Brush.TextPrimary}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource App.Brush.Border}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="10,7,10,7"/>
        <Setter Property="materialDesign:DataGridAssist.ColumnHeaderPadding" Value="10,8"/>
    </Style>

    <Style x:Key="App.GridHeader" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource App.Brush.Primary}"/>
        <Setter Property="Foreground" Value="{StaticResource App.Brush.Surface}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style x:Key="App.PageSurface" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource App.Space.Page}"/>
        <Setter Property="Padding" Value="{StaticResource App.Space.Surface}"/>
        <Setter Property="Background" Value="{StaticResource App.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource App.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style x:Key="App.FilterPanel" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource App.Space.Panel}"/>
        <Setter Property="Background" Value="{StaticResource App.Brush.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource App.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style x:Key="App.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource App.FontSize.Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource App.Brush.TextPrimary}"/>
    </Style>

    <Style x:Key="App.PageSubtitle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="Foreground" Value="{StaticResource App.Brush.TextSecondary}"/>
    </Style>

    <Style x:Key="App.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource App.FontSize.Section}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource App.Brush.TextPrimary}"/>
    </Style>

    <Style x:Key="App.Toast" TargetType="Border">
        <Setter Property="Width" Value="336"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style x:Key="App.ConfirmDialog" TargetType="Border">
        <Setter Property="Width" Value="430"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource App.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource App.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

</ResourceDictionary>
